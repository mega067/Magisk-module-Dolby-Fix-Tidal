<MediaCodecs>
    <Decoders>
        <!-- Dolby AC3 -->
        <MediaCodec name="OMX.dolby.ac3.decoder" type="audio/ac3">
            <Limit name="channel-count" max="6" />
            <Limit name="sample-rate" ranges="8000-48000" />
            <Limit name="bitrate" range="32000-640000" />
        </MediaCodec>
        
        <!-- Dolby EAC3 (DD+) -->
        <MediaCodec name="OMX.dolby.eac3.decoder" type="audio/eac3">
            <Limit name="channel-count" max="8" />
            <Limit name="sample-rate" ranges="8000-48000" />
            <Limit name="bitrate" range="32000-6144000" />
        </MediaCodec>

        <!-- Dolby AC4 -->
        <MediaCodec name="OMX.dolby.ac4.decoder" type="audio/ac4">
            <Limit name="channel-count" max="16" />
            <Limit name="sample-rate" ranges="44100,48000" />
            <Limit name="bitrate" range="32000-2688000" />
        </MediaCodec>
    </Decoders>
</MediaCodecs>
